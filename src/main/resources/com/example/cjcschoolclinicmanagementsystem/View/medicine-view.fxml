<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.MedicineController"
      spacing="16"
      style="-fx-background-color: #f5f5f5;">

    <!-- ── HEADER (no padding on VBox; header is full-width) ── -->
    <HBox style="-fx-background-color: white;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT">
        <padding><Insets top="12" bottom="12" left="18" right="18"/></padding>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Medicine Inventory"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
            <Label text="Track and manage clinic medicine stock"
                   style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER">
            <Button onAction="#exportCSV" text="&#x2B07;  Export CSV"
                    style="-fx-background-color: #f0f0f0; -fx-text-fill: #555;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12;"/>
            <Button onAction="#showAddDialog" text="&#xFF0B;  Add Medicine"
                    style="-fx-background-color: #8B0000; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13;
                           -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- ── CONTENT (padded separately) ── -->
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <padding><Insets left="18" right="18" bottom="8"/></padding>

        <!-- ── SEARCH + SORT on left | STAT CARDS on right ── -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <!-- Search field -->
            <TextField fx:id="txtSearch" promptText="&#x1F50D;  Search medicine name..."
                       onKeyReleased="#onSearch"
                       style="-fx-background-radius: 8; -fx-border-color: #ddd;
                          -fx-border-radius: 8; -fx-padding: 8 12; -fx-font-size: 12;"
                       prefWidth="220"/>

            <!-- Sort dropdown -->
            <ComboBox fx:id="cmbSort" promptText="Sort by..."
                      onAction="#onSortChanged"
                      style="-fx-background-radius: 8; -fx-border-color: #ddd;
                             -fx-border-radius: 8; -fx-font-size: 12; -fx-cursor: hand;"
                      prefWidth="180"/>

            <!-- Spacer pushes cards to right -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Total Medicines -->
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-border-color: #e0e0e0; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>
                <Label text="TOTAL MEDICINES"
                       style="-fx-font-size: 10; -fx-text-fill: #888; -fx-font-weight: bold;"/>
                <Label fx:id="lblTotalMedicines" text="0"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
            </VBox>

            <!-- Low Stock -->
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: #fff8e1; -fx-background-radius: 10;
                     -fx-border-color: #ffe082; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>
                <Label text="&#x1F534;  LOW STOCK"
                       style="-fx-font-size: 10; -fx-text-fill: #e65100; -fx-font-weight: bold;"/>
                <Label fx:id="lblLowStock" text="0"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
            </VBox>

            <!-- Expiring Soon -->
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: #fff0f0; -fx-background-radius: 10;
                     -fx-border-color: #ffcdd2; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>
                <Label text="(!) EXPIRING SOON"
                       style="-fx-font-size: 10; -fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
                <Label fx:id="lblExpiringSoon" text="0"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                <Label text="within 30 days"
                       style="-fx-font-size: 9; -fx-text-fill: #c0392b;"/>
            </VBox>

        </HBox>

        <!-- ── TABLE ── -->
        <TableView fx:id="tblMedicines" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-background-radius: 10;
                      -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName"      text="Medicine Name"   prefWidth="180"/>
                <TableColumn fx:id="colDesc"      text="Description"     prefWidth="200"/>
                <TableColumn fx:id="colUnit"      text="Unit"            prefWidth="80"/>
                <TableColumn fx:id="colQty"       text="In Stock"        prefWidth="80"/>
                <TableColumn fx:id="colLowStock"  text="Low Stock At"    prefWidth="100"/>
                <TableColumn fx:id="colExpiry"    text="Expiry Date"     prefWidth="110"/>
                <TableColumn fx:id="colStatus"    text="Status"          prefWidth="120"/>
                <TableColumn fx:id="colAction"    text="Actions"         prefWidth="160"/>
            </columns>
            <placeholder>
                <Label text="No medicines in inventory. Click '+  Add Medicine' to get started."
                       style="-fx-text-fill: #aaa; -fx-font-size: 13;"/>
            </placeholder>
        </TableView>

        <!-- ── PAGINATION BAR ── -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
            <!-- Left spacer — same width as right side so centre group is truly centred -->
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Centre: Prev / Page label / Next -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnPrev" text="&#x25C4; Prev" onAction="#goToPrevPage"
                        style="-fx-background-color: #8B0000; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11;"/>
                <Label fx:id="lblPage" text="Page 1 of 1"
                       style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                <Button fx:id="btnNext" text="Next &#x25BA;" onAction="#goToNextPage"
                        style="-fx-background-color: #8B0000; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11;"/>
            </HBox>
            <!-- Right spacer + count label -->
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCount" text=""
                   style="-fx-font-size: 11; -fx-text-fill: #888;"/>
        </HBox>
    </VBox>

</VBox>