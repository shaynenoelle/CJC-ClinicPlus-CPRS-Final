<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.MedicineController"
      spacing="16"
      style="-fx-background-color: #f5f5f5;">
    <padding><Insets top="18" bottom="18" left="20" right="20"/></padding>

    <!-- ── HEADER ── -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="💊 Medicine Inventory"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#showAddDialog" text="＋  Add Medicine"
                style="-fx-background-color: #1a237e; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 13;
                       -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;"/>
        <Button onAction="#exportCSV" text="⬇  Export CSV"
                style="-fx-background-color: white; -fx-text-fill: #1a237e;
                       -fx-border-color: #1a237e; -fx-border-radius: 8;
                       -fx-background-radius: 8; -fx-font-size: 13;
                       -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
    </HBox>

    <!-- ── STAT CARDS ── -->
    <HBox spacing="14">
        <!-- Total Medicines -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-border-color: #e0e0e0; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);"
              alignment="CENTER" spacing="4" prefWidth="150">
            <padding><Insets top="14" bottom="14" left="16" right="16"/></padding>
            <Label fx:id="lblTotalMedicines" text="0"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
            <Label text="Total Medicines"
                   style="-fx-font-size: 12; -fx-text-fill: #888;"/>
        </VBox>

        <!-- Low Stock -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-border-color: #e0e0e0; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);"
              alignment="CENTER" spacing="4" prefWidth="150">
            <padding><Insets top="14" bottom="14" left="16" right="16"/></padding>
            <Label fx:id="lblLowStock" text="0"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
            <Label text="🔴 Low Stock"
                   style="-fx-font-size: 12; -fx-text-fill: #888;"/>
        </VBox>

        <!-- Expiring Soon -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-border-color: #e0e0e0; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);"
              alignment="CENTER" spacing="4" prefWidth="150">
            <padding><Insets top="14" bottom="14" left="16" right="16"/></padding>
            <Label fx:id="lblExpiringSoon" text="0"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
            <Label text="⚠ Expiring Soon"
                   style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="within 30 days"
                   style="-fx-font-size: 11; -fx-text-fill: #bbb;"/>
        </VBox>
    </HBox>

    <!-- ── SEARCH BAR ── -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="🔍  Search medicine name…"
                   onKeyReleased="#onSearch"
                   style="-fx-background-radius: 8; -fx-border-color: #ddd;
                          -fx-border-radius: 8; -fx-padding: 8 12 8 12; -fx-font-size: 13;"
                   prefWidth="320"/>
    </HBox>

    <TableView fx:id="tblMedicines" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;
                  -fx-border-color: #e0e0e0; -fx-border-radius: 10;">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="colName"      text="Medicine Name"   prefWidth="180"/>
            <TableColumn fx:id="colDesc"      text="Description"     prefWidth="200"/>
            <TableColumn fx:id="colUnit"      text="Unit"            prefWidth="80"/>
            <TableColumn fx:id="colQty"       text="In Stock"        prefWidth="80"/>
            <TableColumn fx:id="colLowStock"  text="Low Stock At"    prefWidth="100"/>
            <TableColumn fx:id="colExpiry"    text="Expiry Date"     prefWidth="110"/>
            <TableColumn fx:id="colStatus"    text="Status"          prefWidth="120"/>
            <TableColumn fx:id="colAction"    text="Actions"         prefWidth="160"/>
        </columns>

        <placeholder>
            <Label text="No medicines in inventory. Click '＋ Add Medicine' to get started."
                   style="-fx-text-fill: #aaa; -fx-font-size: 13;"/>
        </placeholder>
    </TableView>

</VBox>
