<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.LoginController">

    <!-- LEFT SIDE: Branding — grows to fill available space -->
    <VBox alignment="CENTER"
          style="-fx-background-color: #f0f4f8;"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="20">

            <ImageView fitHeight="130" fitWidth="130"
                       pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../Images/cliniclogov3.png"/>
                </image>
            </ImageView>

            <!-- CJC-Clinic+ name -->
            <HBox alignment="CENTER" spacing="0">
                <Label text="CJC-Clinic" textFill="#c41e3a"
                       style="-fx-font-size: 34; -fx-font-weight: bold;"/>
                <Label text="+" textFill="#c41e3a"
                       style="-fx-font-size: 22; -fx-font-weight: bold;
                              -fx-padding: 0 0 14 2;"/>
            </HBox>

            <Label text="Clinic Patient Records System"
                   textFill="#5a6c7d"
                   style="-fx-font-size: 15;"/>

            <Separator maxWidth="280"/>

            <Label fx:id="taglineLabel"
                   text="Golden Heart. Healing Hands."
                   textFill="#7f8c8d"
                   wrapText="true"
                   maxWidth="320"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-size: 14; -fx-font-weight: bold;
                          -fx-text-alignment: CENTER; -fx-opacity: 0.0;">
                <font><Font name="System Bold" size="14"/></font>
            </Label>

            <!-- Developer Credits -->
            <Label text="Developed by: Bangcailan, Shayne Noelle &amp; Ngojo, Prince Joshua"
                   textFill="#bbbbbb"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   wrapText="true"
                   maxWidth="320"
                   style="-fx-font-size: 10; -fx-font-style: italic;"/>
            <Label text="BSCS-3 | Software Engineering 1 | S.Y. 2025-2026"
                   textFill="#cccccc"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-size: 10;"/>

        </VBox>
    </VBox>

    <!-- RIGHT SIDE: Login Form — grows to fill available space -->
    <VBox alignment="CENTER" spacing="18"
          style="-fx-background-color: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity">
        <padding>
            <Insets bottom="40" left="50" right="50" top="40"/>
        </padding>

        <Label text="Sign In" textFill="#c41e3a">
            <font><Font name="System Bold" size="28"/></font>
        </Label>

        <Label text="Access your patient information"
               textFill="#666666"
               style="-fx-font-size: 13;"/>

        <VBox alignment="CENTER" spacing="12"
              style="-fx-padding: 28;
                     -fx-background-color: white;
                     -fx-border-color: #e0e0e0;
                     -fx-border-radius: 10;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);"
              maxWidth="420">

            <!-- USERNAME -->
            <Label text="Username" textFill="#333333"
                   style="-fx-font-weight: bold; -fx-font-size: 13;" maxWidth="Infinity"/>
            <TextField fx:id="txtUsername"
                       promptText="Enter your username"
                       maxWidth="Infinity"
                       prefHeight="44"
                       style="-fx-background-radius: 6; -fx-border-color: #e0e0e0;
                              -fx-border-radius: 6; -fx-padding: 10 12 10 12; -fx-font-size: 13;"/>

            <!-- PASSWORD -->
            <Label text="Password" textFill="#333333"
                   style="-fx-font-weight: bold; -fx-font-size: 13;" maxWidth="Infinity"/>
            <StackPane maxWidth="Infinity">
                <PasswordField fx:id="txtPassword"
                               promptText="Enter your password"
                               prefHeight="44" maxWidth="Infinity"
                               style="-fx-background-radius: 6; -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 6; -fx-padding: 10 46 10 12; -fx-font-size: 13;"/>
                <TextField fx:id="txtPasswordVisible"
                           promptText="Enter your password"
                           prefHeight="44" maxWidth="Infinity"
                           visible="false" managed="false"
                           style="-fx-background-radius: 6; -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 6; -fx-padding: 10 46 10 12; -fx-font-size: 13;"/>
                <!-- Eye icon -->
                <Label fx:id="btnTogglePassword"
                       text="👁"
                       onMouseClicked="#onTogglePassword"
                       style="-fx-cursor: hand; -fx-font-size: 16;"
                       StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="14"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <!-- REMEMBER ME + FORGOT PASSWORD -->
            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8">
                <CheckBox fx:id="chkRemember"
                          text="Remember me"
                          style="-fx-font-size: 13; -fx-text-fill: #555;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?"
                           onAction="#onForgotPasswordClick"
                           style="-fx-font-size: 12; -fx-text-fill: #8B0000; -fx-border-color: transparent;"/>
            </HBox>

            <!-- SIGN IN BUTTON -->
            <Button maxWidth="Infinity" prefHeight="46"
                    onAction="#onLoginClick"
                    text="SIGN IN"
                    style="-fx-background-color: linear-gradient(to right, #c41e3a, #d63856);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-font-size: 14; -fx-border-radius: 6; -fx-background-radius: 6;"/>

            <Label fx:id="lblStatus" textFill="RED"
                   style="-fx-font-size: 12;"/>
        </VBox>

        <Label text="© 2026 Cor Jesu College Clinic"
               textFill="#999999">
            <font><Font size="11"/></font>
        </Label>
    </VBox>

</HBox>
