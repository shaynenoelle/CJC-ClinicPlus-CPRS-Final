<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.LoginController">

    <!-- LEFT SIDE: Branding -->
    <VBox alignment="CENTER"
          style="-fx-background-color: #f0f4f8;"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity">
        <padding>
            <Insets bottom="60" left="60" right="60" top="60"/>
        </padding>

        <VBox alignment="CENTER" spacing="24">

            <ImageView fitHeight="150" fitWidth="150"
                       pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../Images/cliniclogov3.png"/>
                </image>
            </ImageView>

            <!-- CJC-Clinic+ name -->
            <HBox alignment="CENTER" spacing="0">
                <Label text="CJC-Clinic" textFill="#c41e3a"
                       style="-fx-font-size: 38; -fx-font-weight: bold;"/>
                <Label text="+" textFill="#c41e3a"
                       style="-fx-font-size: 24; -fx-font-weight: bold;
                              -fx-padding: 0 0 16 2;"/>
            </HBox>

            <Label text="Clinic Patient Records System"
                   textFill="#5a6c7d"
                   style="-fx-font-size: 16;"/>

            <Separator maxWidth="300"/>

            <Label fx:id="taglineLabel"
                   text="Golden Heart. Healing Hands."
                   textFill="#7f8c8d"
                   wrapText="true"
                   maxWidth="340"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-size: 15; -fx-font-weight: bold;
              -fx-text-alignment: CENTER; -fx-opacity: 0.0;">
                <font><Font name="System Bold" size="15"/></font>
            </Label>

            <!-- Developer Credits -->
            <Label text="Developed by: Bangcailan, Shayne Noelle &amp; Ngojo, Prince Joshua"
                   textFill="#bbbbbb"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   wrapText="true"
                   maxWidth="340"
                   style="-fx-font-size: 10; -fx-font-style: italic;"/>
            <Label text="BSCS-3 | Software Engineering 1 | S.Y. 2025-2026"
                   textFill="#cccccc"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-size: 10;"/>

        </VBox>
    </VBox>

    <!-- RIGHT SIDE: Login Form -->
    <VBox alignment="CENTER" spacing="22"
          style="-fx-background-color: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity">
        <padding>
            <Insets bottom="60" left="70" right="70" top="60"/>
        </padding>

        <Label text="Sign In" textFill="#c41e3a">
            <font><Font name="System Bold" size="32"/></font>
        </Label>

        <Label text="Access your patient information"
               textFill="#666666"
               style="-fx-font-size: 14;"/>

        <VBox alignment="CENTER" spacing="14"
              style="-fx-padding: 35;
                     -fx-background-color: white;
                     -fx-border-color: #e0e0e0;
                     -fx-border-radius: 10;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);"
              maxWidth="420">

            <!-- USERNAME -->
            <Label text="Username" textFill="#333333"
                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            <TextField fx:id="txtUsername"
                       promptText="Enter your username"
                       prefHeight="46" prefWidth="380"
                       style="-fx-background-radius: 6;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 6;
                              -fx-padding: 10 12 10 12;
                              -fx-font-size: 14;"/>

            <!-- PASSWORD -->
            <Label text="Password" textFill="#333333"
                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            <StackPane prefWidth="380" maxWidth="380">
                <PasswordField fx:id="txtPassword"
                               promptText="Enter your password"
                               prefHeight="46" prefWidth="380"
                               style="-fx-background-radius: 6;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 6;
                                      -fx-padding: 10 46 10 12;
                                      -fx-font-size: 14;"/>
                <TextField fx:id="txtPasswordVisible"
                           promptText="Enter your password"
                           prefHeight="46" prefWidth="380"
                           visible="false" managed="false"
                           style="-fx-background-radius: 6;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 6;
                                  -fx-padding: 10 46 10 12;
                                  -fx-font-size: 14;"/>
                <!-- Eye icon -->
                <Label fx:id="btnTogglePassword"
                       text="👁"
                       onMouseClicked="#onTogglePassword"
                       style="-fx-cursor: hand; -fx-font-size: 16;"
                       StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="14"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <!-- REMEMBER ME -->
            <HBox alignment="CENTER_LEFT" prefWidth="380">
                <CheckBox fx:id="chkRemember"
                          text="Remember me"
                          style="-fx-font-size: 13; -fx-text-fill: #555;"/>
            </HBox>

            <!-- SIGN IN BUTTON -->
            <Button maxWidth="Infinity" prefHeight="50"
                    onAction="#onLoginClick"
                    text="SIGN IN"
                    style="-fx-background-color: linear-gradient(to right, #c41e3a, #d63856);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;
                           -fx-font-size: 15;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;"/>

            <Label fx:id="lblStatus" textFill="RED"
                   style="-fx-font-size: 12;"/>
        </VBox>

        <Label text="© 2026 Cor Jesu College Clinic"
               textFill="#999999">
            <font><Font size="12"/></font>
        </Label>
    </VBox>

</HBox>
