<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="14"
      minWidth="620"
      prefWidth="-1"
      style="-fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.AttendController">
    <padding><Insets top="20" bottom="20" left="22" right="22"/></padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="✚" style="-fx-text-fill: #8B0000; -fx-font-size: 20;"/>
        <VBox>
            <Label text="Recording Visit For:"
                   style="-fx-font-size: 11; -fx-text-fill: #888;"/>
            <Label fx:id="lblPatientName"
                   text="Patient Name"
                   HBox.hgrow="ALWAYS"
                   maxWidth="1.7976931348623157E308"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="16" alignment="CENTER_RIGHT">
            <VBox alignment="CENTER_RIGHT">
                <Label text="Date:" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                <Label fx:id="lblDate"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="Attended by:" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                <Label fx:id="lblAttendedBy"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="Time In:"
                       style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <TextField fx:id="txtTimeIn"
                               promptText="HH:mm"
                               prefWidth="80" prefHeight="30"
                               style="-fx-background-radius: 5;
                                     -fx-border-color: #ddd;
                                     -fx-border-radius: 5;
                                     -fx-padding: 4 8 4 8;
                                     -fx-font-size: 12;"/>
                    <Button text="⏱ Now"
                            onAction="#setTimeIn"
                            style="-fx-background-color: #e8e8e8;
                                  -fx-text-fill: #333;
                                  -fx-background-radius: 5;
                                  -fx-cursor: hand;
                                  -fx-font-size: 11;"/>
                </HBox>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="Time Out (optional):"
                       style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <TextField fx:id="txtTimeOut"
                               promptText="HH:mm"
                               prefWidth="80" prefHeight="30"
                               style="-fx-background-radius: 5;
                                     -fx-border-color: #ddd;
                                     -fx-border-radius: 5;
                                     -fx-padding: 4 8 4 8;
                                     -fx-font-size: 12;"/>
                    <Button text="⏱ Now"
                            onAction="#setTimeOut"
                            style="-fx-background-color: #e8e8e8;
                                  -fx-text-fill: #333;
                                  -fx-background-radius: 5;
                                  -fx-cursor: hand;
                                  -fx-font-size: 11;"/>
                </HBox>
            </VBox>
        </HBox>
    </HBox>

    <Separator/>

    <!-- TABS -->
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             onMouseClicked="#onTabChanged">

        <!-- ═══ TAB 1: Vital Signs ═══════════════════════════════════════ -->
        <Tab text="Vital Signs">
            <VBox spacing="14">
                <padding><Insets top="16" bottom="8" left="4" right="4"/></padding>

                <Label text="All vital signs are optional — fill in only what was measured"
                       style="-fx-font-size: 11; -fx-text-fill: #2196F3; -fx-font-style: italic;"/>

                <GridPane hgap="16" vgap="12">
                    <!-- Temperature -->
                    <Label text="Temperature (°C)" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <TextField fx:id="txtTemperature"
                               promptText="e.g. 36.5"
                               prefWidth="180" prefHeight="38"
                               onKeyReleased="#validateVitals"
                               onKeyPressed="#onTempKeyPressed"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                    <Label fx:id="lblTempWarning" text=""
                           GridPane.rowIndex="0" GridPane.columnIndex="2"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <!-- Blood Pressure -->
                    <Label text="Blood Pressure (mmHg)" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT"
                          GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="txtBpSystolic"
                                   promptText="120"
                                   prefWidth="80" prefHeight="38"
                                   onKeyReleased="#validateVitals"
                                   style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                          -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                        <Label text="/" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtBpDiastolic"
                                   promptText="80"
                                   prefWidth="80" prefHeight="38"
                                   onKeyReleased="#validateVitals"
                                   style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                          -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                    </HBox>
                    <Label fx:id="lblBpWarning" text=""
                           GridPane.rowIndex="1" GridPane.columnIndex="2"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <!-- Heart Rate -->
                    <Label text="Heart Rate (BPM)" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <TextField fx:id="txtHeartRate"
                               promptText="e.g. 75"
                               prefWidth="180" prefHeight="38"
                               onKeyReleased="#validateVitals"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                    <Label fx:id="lblHrWarning" text=""
                           GridPane.rowIndex="2" GridPane.columnIndex="2"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <!-- Oxygen Saturation -->
                    <Label text="Oxygen Saturation (%)" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <TextField fx:id="txtOxygen"
                               promptText="e.g. 98"
                               prefWidth="180" prefHeight="38"
                               onKeyReleased="#validateVitals"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                    <Label fx:id="lblO2Warning" text=""
                           GridPane.rowIndex="3" GridPane.columnIndex="2"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <!-- Respiratory Rate -->
                    <Label text="Respiratory Rate (CPM)" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <TextField fx:id="txtRespiratoryRate"
                               promptText="e.g. 16"
                               prefWidth="180" prefHeight="38"
                               onKeyReleased="#validateVitals"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                      -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13;"/>
                    <Label fx:id="lblRrWarning" text=""
                           GridPane.rowIndex="4" GridPane.columnIndex="2"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>
                </GridPane>
            </VBox>
        </Tab>

        <!-- ═══ TAB 2: Visit Details ══════════════════════════════════════ -->
        <Tab text="Visit Details">
            <VBox spacing="12">
                <padding><Insets top="16" bottom="8" left="4" right="4"/></padding>

                <!-- Cues label row -->
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="Cues"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <Label text=" *"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label text="(symptoms, complaints, observations)"
                           style="-fx-font-size: 11; -fx-text-fill: #999; -fx-padding: 0 0 0 4;"/>
                </HBox>

                <!-- Dropdown + free-type input row -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="comboCues"
                              editable="true"
                              HBox.hgrow="ALWAYS"
                              maxWidth="1.7976931348623157E308"
                              promptText="Select preset or type a cue…"
                              onKeyPressed="#onCuesKeyPressed"
                              style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-font-size: 13;"/>
                    <Button fx:id="btnAddCue"
                            text="+ Add"
                            onAction="#onAddCue"
                            prefHeight="36"
                            style="-fx-background-color: #8B0000;
                                  -fx-text-fill: white;
                                  -fx-background-radius: 6;
                                  -fx-cursor: hand;
                                  -fx-font-size: 12;
                                  -fx-font-weight: bold;
                                  -fx-padding: 6 14 6 14;"/>
                </HBox>

                <!-- Chip display area -->
                <FlowPane fx:id="cuesFlowPane"
                          hgap="6" vgap="6"
                          prefWrapLength="500"
                          minHeight="36"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e0e0e0;
                                 -fx-border-radius: 6;
                                 -fx-background-radius: 6;
                                 -fx-padding: 8;"/>

                <Label text="(Press Enter or click + Add to add a cue. Click × on a chip to remove it.)"
                       style="-fx-font-size: 10; -fx-text-fill: #aaa; -fx-font-style: italic;"/>

                <Separator/>

                <Label text="Treatment Given"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                <TextArea fx:id="txtTreatment"
                          promptText="Medication, rest, referral..."
                          prefHeight="80" wrapText="true"
                          onKeyPressed="#onTreatmentKeyPressed"
                          style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                 -fx-border-radius: 5; -fx-font-size: 13;"/>

                <Label text="Remarks / Nurse Notes"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                <TextArea fx:id="txtRemarks"
                          promptText="Additional observations..."
                          prefHeight="80" wrapText="true"
                          onKeyPressed="#onRemarksKeyPressed"
                          style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                 -fx-border-radius: 5; -fx-font-size: 13;"/>

                <Separator/>

                <!-- Previous visits reference table -->
                <Label text="Patient's Visit History"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                <TableView fx:id="tblPreviousVisits" prefHeight="160"
                           style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 5; -fx-background-radius: 5;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colPrevDate"      text="Date"      prefWidth="90"/>
                        <TableColumn fx:id="colPrevCues"      text="Cues"      prefWidth="160"/>
                        <TableColumn fx:id="colPrevTreatment" text="Treatment" prefWidth="130"/>
                        <TableColumn fx:id="colPrevRemarks"   text="Remarks"   prefWidth="130"/>
                        <TableColumn fx:id="colPrevVitals"    text="Vitals"    prefWidth="150"/>
                    </columns>
                    <placeholder>
                        <Label text="No previous visits on record."
                               style="-fx-text-fill: #aaa; -fx-font-size: 12;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- ═══ TAB 3: Re-checks (Follow-ups) ════════════════════════════ -->
        <!--
            This tab is always present but the tab title badge (e.g. "Re-checks 🔴 2")
            is updated dynamically in AttendController.loadFollowUps().
        -->
        <Tab fx:id="tabFollowUps" text="Re-checks">
            <VBox spacing="12">
                <padding><Insets top="16" bottom="8" left="4" right="4"/></padding>

                <!-- Header row: info label + Schedule button -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Re-check Schedule"
                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <Label fx:id="lblFollowUpCount"
                               text="No re-checks scheduled."
                               style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                    </VBox>

                    <!--
                        "+ Schedule Re-check" button.
                        Hidden in read-only mode (VisitHistoryController sets isReadOnly=true).
                        The nurse clicks this after saving the initial visit record.
                    -->
                    <Button fx:id="btnScheduleRecheck"
                            text="＋ Schedule Re-check"
                            onAction="#onScheduleRecheck"
                            prefHeight="36"
                            style="-fx-background-color: #8B0000;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;
                                   -fx-font-size: 12;
                                   -fx-font-weight: bold;
                                   -fx-padding: 6 14 6 14;"/>
                </HBox>

                <Label text="The re-check time is shown as a badge in the Logbook. When it is time, click ✚ Re-check to record the new vitals."
                       wrapText="true"
                       style="-fx-font-size: 11; -fx-text-fill: #2196F3; -fx-font-style: italic;"/>

                <Separator/>

                <!-- Re-checks table -->
                <TableView fx:id="tblFollowUps" VBox.vgrow="ALWAYS"
                           prefHeight="260"
                           style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 5; -fx-background-radius: 5;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colFuScheduled" text="Scheduled"    prefWidth="75"/>
                        <TableColumn fx:id="colFuStatus"    text="Status"       prefWidth="68"/>
                        <TableColumn fx:id="colFuNotes"     text="Nurse Note"   prefWidth="130"/>
                        <TableColumn fx:id="colFuActual"    text="Actual Time"  prefWidth="75"/>
                        <TableColumn fx:id="colFuVitals"    text="Vitals"       prefWidth="155"/>
                        <TableColumn fx:id="colFuRemarks"   text="Remarks"      prefWidth="130"/>
                        <TableColumn fx:id="colFuAction"    text="Action"       prefWidth="145"/>
                    </columns>
                    <placeholder>
                        <Label text="No re-checks scheduled yet.  Click '＋ Schedule Re-check' above."
                               style="-fx-text-fill: #aaa; -fx-font-size: 12;"/>
                    </placeholder>
                </TableView>

                <Label text="Re-checks are linked to this visit and visible in Visit History."
                       style="-fx-font-size: 10; -fx-text-fill: #bbb; -fx-font-style: italic;"/>
            </VBox>
        </Tab>

    </TabPane>

    <Separator/>

    <!-- FOOTER BUTTONS -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Label fx:id="lblSaveStatus" text=""
               style="-fx-font-size: 11;" HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStep" text="Step 1 of 3"
               style="-fx-text-fill: #888; -fx-font-size: 11;"/>
        <Button text="Cancel" prefWidth="100" prefHeight="38"
                onAction="#onCancel"
                style="-fx-background-color: #e0e0e0;
                       -fx-text-fill: #333;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnBack" text="◀  Back" prefWidth="100" prefHeight="38"
                managed="false" visible="false"
                onAction="#onBack"
                style="-fx-background-color: #555;
                       -fx-text-fill: white;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnNext" text="Next  ▶" prefWidth="130" prefHeight="38"
                onAction="#onNext"
                style="-fx-background-color: #8B0000;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnSave" text="Save Record" prefWidth="130" prefHeight="38"
                managed="false" visible="false"
                onAction="#onSaveRecord"
                style="-fx-background-color: #8B0000;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </HBox>
</VBox>
