<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.SettingsController"
      spacing="0" style="-fx-background-color: #F5F5F5;">

    <!-- Header -->
    <HBox style="-fx-background-color: #8B0000; -fx-padding: 16 25;">
        <Label text="⚙  SETTINGS" textFill="WHITE">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
    </HBox>

    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-tab-min-width: 120; -fx-tab-max-width: 180;">

        <!-- ══════════════════ ACADEMIC SETUP ══════════════════ -->
        <Tab text="🏫  Academic Setup">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- School Year -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="School Year" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Set the current school year shown on patient records and reports." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Current School Year:" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtSchoolYear" promptText="e.g. 2025-2026" prefWidth="160"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8; -fx-font-size: 13; -fx-text-fill: #8B0000; -fx-font-weight: bold;"/>
                            <Button text="Save" onAction="#saveSchoolYear"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                        </HBox>
                        <Label fx:id="lblSchoolYearStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Departments -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Departments / Colleges" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="These appear in the College/Dept dropdown when adding or editing a patient." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <HBox spacing="10">
                            <ListView fx:id="lstDepartments" prefHeight="160" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                            <VBox spacing="8" alignment="TOP_CENTER">
                                <TextField fx:id="txtNewDept" promptText="New department..." prefWidth="180"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 7;"/>
                                <Button text="Add" onAction="#addDepartment" maxWidth="Infinity"
                                        style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                                <Button text="Remove Selected" onAction="#removeDepartment" maxWidth="Infinity"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="lblDeptStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Courses -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Courses / Programs" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="These appear in the Course dropdown when adding or editing a patient." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <HBox spacing="10">
                            <ListView fx:id="lstCourses" prefHeight="160" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                            <VBox spacing="8" alignment="TOP_CENTER">
                                <TextField fx:id="txtNewCourse" promptText="New course..." prefWidth="180"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 7;"/>
                                <Button text="Add" onAction="#addCourse" maxWidth="Infinity"
                                        style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                                <Button text="Remove Selected" onAction="#removeCourse" maxWidth="Infinity"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="lblCourseStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ CLINICAL PRESETS ══════════════════ -->
        <Tab text="Clinical Presets">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <Label text="Define preset lists so nurses pick from a consistent set of terms instead of free-typing. This keeps charts and reports accurate."
                           wrapText="true" style="-fx-text-fill: #555; -fx-font-size: 12;"/>

                    <!-- Diagnosis Presets -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Diagnosis Presets" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Common diagnoses shown as suggestions in the Attend form." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <HBox spacing="10">
                            <ListView fx:id="lstDiagnosisPresets" prefHeight="160" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                            <VBox spacing="8" alignment="TOP_CENTER">
                                <TextField fx:id="txtNewDiagnosis" promptText="e.g. Fever, Diarrhea..." prefWidth="200"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 7;"/>
                                <Button text="Add" onAction="#addDiagnosisPreset" maxWidth="Infinity"
                                        style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                                <Button text="Remove Selected" onAction="#removeDiagnosisPreset" maxWidth="Infinity"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="lblDiagnosisStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Chief Complaint Presets -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Chief Complaint Presets" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Common complaints shown as suggestions in the Attend form." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <HBox spacing="10">
                            <ListView fx:id="lstComplaintPresets" prefHeight="160" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                            <VBox spacing="8" alignment="TOP_CENTER">
                                <TextField fx:id="txtNewComplaint" promptText="e.g. Headache, Stomachache..." prefWidth="200"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 7;"/>
                                <Button text="Add" onAction="#addComplaintPreset" maxWidth="Infinity"
                                        style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                                <Button text="Remove Selected" onAction="#removeComplaintPreset" maxWidth="Infinity"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="lblComplaintStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Medicine List -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Medicine / Treatment List" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <HBox spacing="8" alignment="CENTER_LEFT"
                              style="-fx-background-color: #fff8e1; -fx-border-color: #ffe082; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8 12;">
                            <Label text="Reference list only — full inventory integration planned for a future release."
                                   wrapText="true" style="-fx-font-size: 11; -fx-text-fill: #795548;"/>
                        </HBox>
                        <HBox spacing="10">
                            <ListView fx:id="lstMedicines" prefHeight="160" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                            <VBox spacing="8" alignment="TOP_CENTER">
                                <TextField fx:id="txtNewMedicine" promptText="e.g. Paracetamol 500mg..." prefWidth="200"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 7;"/>
                                <Button text="Add" onAction="#addMedicine" maxWidth="Infinity"
                                        style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                                <Button text="Remove Selected" onAction="#removeMedicine" maxWidth="Infinity"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 16; -fx-background-radius: 5;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="lblMedicineStatus" text="" style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ USER MANAGEMENT ══════════════════ -->
        <Tab text="User Management">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- User List + Actions -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="System Users" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Staff accounts that can log in to this system. Select a user before using Reset or Delete." style="-fx-text-fill: #555; -fx-font-size: 12;"/>
                        <TableView fx:id="userTable" prefHeight="160"
                                   style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colUsername" text="Username" prefWidth="300"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <HBox spacing="10">
                            <Button text="Add User" onAction="#handleAddUser"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                            <Button text="Reset Password" onAction="#handleResetSelectedPassword"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                            <Button text="Delete User" onAction="#handleDeleteUser"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                        </HBox>
                    </VBox>

                    <!-- Change Own Password -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Change My Password" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="280"/>
                            </columnConstraints>
                            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtCurrentUsername" promptText="Your username"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtOldPassword" promptText="Current password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtNewPassword" promptText="New password (min 6 chars)"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter new password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                        </GridPane>
                        <Label fx:id="lblPasswordStrength" text="" style="-fx-font-style: italic;"/>
                        <Button text="Change Password" onAction="#handleChangePassword"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ DATA IMPORT ══════════════════ -->
        <Tab text="Data Import">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="14">
                        <Label text="Import Enrollees from Registrar" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>

                        <!-- In-development notice -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: #e8f4fd; -fx-border-color: #90caf9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 12 16;">
                            <VBox spacing="3">
                                <Label text="Feature In Development" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1565C0;"/>
                                <Label text="Enrollee import from Excel / CSV will be completed before final submission. The button below is a placeholder — it will show a coming soon message when clicked."
                                       wrapText="true" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
                            </VBox>
                        </HBox>

                        <Label text="Each semester, drop in the enrollment list from the Registrar's Office to automatically populate patient records — no manual entry needed."
                               wrapText="true" style="-fx-text-fill: #555; -fx-font-size: 12;"/>

                        <!-- Expected format box -->
                        <VBox spacing="5" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12;">
                            <Label text="Expected File Format" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #444;"/>
                            <Label text="  File type: Excel (.xlsx) or CSV (.csv)" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
                            <Label text="  Required columns: Student ID, Last Name, First Name, Course, Year Level, Department" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
                            <Label text="  Optional columns: Gender, Birthdate, Contact No., Email" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
                            <Label text="  Duplicate IDs will be skipped — only new enrollees are added" style="-fx-font-size: 11; -fx-text-fill: #555;"/>
                        </VBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="txtImportFilePath" promptText="No file selected..."
                                       prefWidth="380" editable="false"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8; -fx-text-fill: #777;"/>
                            <Button text="Browse File" onAction="#browseImportFile"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18; -fx-background-radius: 5;"/>
                        </HBox>

                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Button text="Import Enrollees" onAction="#handleImportEnrollees"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 28; -fx-font-size: 13; -fx-background-radius: 5;"/>
                            <Label fx:id="lblImportStatus" text=""
                                   style="-fx-font-size: 12; -fx-font-style: italic; -fx-text-fill: #555;"/>
                        </HBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ DATA BACKUP ══════════════════ -->
        <Tab text="Data Backup">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Manual Backup" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Create a full copy of the database file right now." style="-fx-text-fill: #555;"/>
                        <HBox spacing="12">
                            <TextField fx:id="txtBackupPath" promptText="Backup destination folder..."
                                       prefWidth="420"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="Browse" onAction="#browseBackupFolder"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </HBox>
                        <HBox spacing="12">
                            <Button text="Backup Now" onAction="#handleBackupNow"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 28; -fx-font-size: 13;"/>
                            <Button text="Export Patients (CSV)" onAction="#handleExportPatients"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13;"/>
                            <Button text="Export Visits (CSV)" onAction="#handleExportVisits"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13;"/>
                        </HBox>
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Automatic Backup" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <CheckBox fx:id="chkAutoBackup" text="Enable automatic backup" style="-fx-font-size: 13;"/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="200"/>
                            </columnConstraints>
                            <Label text="Backup Frequency:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="comboBackupFrequency" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Backup Time:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Spinner fx:id="spinnerHour" prefWidth="65" editable="true"/>
                                <Label text=":" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                                <Spinner fx:id="spinnerMinute" prefWidth="65" editable="true"/>
                                <ComboBox fx:id="comboAMPM" prefWidth="75"/>
                            </HBox>
                            <Label text="Auto Backup Folder:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <TextField fx:id="txtAutoBackupPath" promptText="Auto backup folder..." prefWidth="280"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 6;"/>
                                <Button text="Browse" onAction="#browseAutoBackupFolder"
                                        style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
                            </HBox>
                        </GridPane>
                        <Label fx:id="lblNextBackup" text="Next backup: -" style="-fx-text-fill: #555; -fx-font-style: italic;"/>
                        <Button text="Save Backup Settings" onAction="#saveBackupSettings"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="8">
                        <Label text="Backup History" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label fx:id="lblLastBackup" text="Last backup: Never" style="-fx-text-fill: #555;"/>
                        <Label fx:id="lblLastExport" text="Last export: Never" style="-fx-text-fill: #555;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ APPEARANCE ══════════════════ -->
        <Tab text="Appearance">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">
