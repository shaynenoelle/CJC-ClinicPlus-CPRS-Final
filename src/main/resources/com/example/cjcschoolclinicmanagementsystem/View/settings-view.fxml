<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.SettingsController"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <HBox style="-fx-background-color: #8B0000; -fx-padding: 20;">
            <Label text="Settings" textFill="WHITE">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <Label text="Application Settings" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <VBox spacing="10">
                <Label text="Theme:"/>
                <ComboBox fx:id="themeComboBox" prefWidth="300" promptText="Select Theme"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Font Size:"/>
                <Slider fx:id="fontSizeSlider" min="10" max="20" value="14" showTickLabels="true" showTickMarks="true"/>
            </VBox>

            <CheckBox fx:id="notificationsCheckBox" text="Enable Notifications"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Save" onAction="#saveSettings" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="Cancel" onAction="#closeSettings" style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-padding: 10 30;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>

