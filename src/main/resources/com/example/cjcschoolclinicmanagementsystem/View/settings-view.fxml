<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.SettingsController"
      spacing="0" style="-fx-background-color: #F5F5F5;">

    <!-- Header -->
    <HBox style="-fx-background-color: #8B0000; -fx-padding: 18 25;">
        <Label text="⚙  SETTINGS" textFill="WHITE">
            <font><Font name="System Bold" size="22.0"/></font>
        </Label>
    </HBox>

    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-tab-min-width: 140; -fx-tab-max-width: 140;">

        <!-- ══════════════════ DATA BACKUP ══════════════════ -->
        <Tab text="💾  Data Backup">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- Manual Backup -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Manual Backup" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Create a full copy of the database file right now." style="-fx-text-fill: #555;"/>
                        <HBox spacing="12">
                            <TextField fx:id="txtBackupPath" promptText="Backup destination folder..."
                                       prefWidth="420"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="📂 Browse" onAction="#browseBackupFolder"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </HBox>
                        <HBox spacing="12">
                            <Button text="💾 Backup Now" onAction="#handleBackupNow"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 28; -fx-font-size: 13;"/>
                            <Button text="📤 Export Patients (CSV)" onAction="#handleExportPatients"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13;"/>
                            <Button text="📋 Export Visits (CSV)" onAction="#handleExportVisits"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13;"/>
                        </HBox>
                    </VBox>

                    <!-- Auto Backup -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Automatic Backup" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <CheckBox fx:id="chkAutoBackup" text="Enable automatic backup" style="-fx-font-size: 13;"/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="200"/>
                            </columnConstraints>
                            <Label text="Backup Frequency:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="comboBackupFrequency" prefWidth="180"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Backup Time:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Spinner fx:id="spinnerHour" prefWidth="65" editable="true"/>
                                <Label text=":" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                                <Spinner fx:id="spinnerMinute" prefWidth="65" editable="true"/>
                                <ComboBox fx:id="comboAMPM" prefWidth="75"/>
                            </HBox>
                            <Label text="Auto Backup Folder:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <TextField fx:id="txtAutoBackupPath" promptText="Auto backup folder..." prefWidth="280"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 6;"/>
                                <Button text="📂" onAction="#browseAutoBackupFolder"
                                        style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
                            </HBox>
                        </GridPane>
                        <Label fx:id="lblNextBackup" text="Next backup: —" style="-fx-text-fill: #555; -fx-font-style: italic;"/>
                        <Button text="💾 Save Backup Settings" onAction="#saveBackupSettings"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                    <!-- Last Backup Info -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="8">
                        <Label text="Backup History" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label fx:id="lblLastBackup" text="Last backup: Never" style="-fx-text-fill: #555;"/>
                        <Label fx:id="lblLastExport" text="Last export: Never" style="-fx-text-fill: #555;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ ACCOUNT MANAGEMENT ══════════════════ -->
        <Tab text="👤  Accounts">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- Change Own Password -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="Change My Password" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="280"/>
                            </columnConstraints>
                            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtCurrentUsername" promptText="Your username"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtOldPassword" promptText="Current password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtNewPassword" promptText="New password (min 6 chars)"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter new password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                        </GridPane>
                        <Label fx:id="lblPasswordStrength" text="" style="-fx-font-style: italic;"/>
                        <Button text="🔒 Change Password" onAction="#handleChangePassword"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                    <!-- User Management -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="12">
                        <Label text="User Management" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Manage clinic system users. You can add new users or reset their passwords." style="-fx-text-fill: #555;"/>
                        <TableView fx:id="userTable" prefHeight="180">
                            <columns>
                                <TableColumn fx:id="colUsername" text="Username" prefWidth="300"/>
                            </columns>
                        </TableView>
                        <HBox spacing="12">
                            <Button text="➕ Add User" onAction="#handleAddUser"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🔑 Reset Password" onAction="#handleResetSelectedPassword"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Delete User" onAction="#handleDeleteUser"
                                    style="-fx-background-color: #B71C1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ APPEARANCE ══════════════════ -->
        <Tab text="🎨  Appearance">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="14">
                        <Label text="Display Preferences" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <GridPane hgap="15" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="250"/>
                            </columnConstraints>
                            <Label text="Theme:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="themeComboBox" prefWidth="220"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Font Size:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Slider fx:id="fontSizeSlider" min="10" max="20" value="14"
                                        showTickLabels="true" showTickMarks="true" prefWidth="200"/>
                                <Label fx:id="lblFontSize" text="14 pt" style="-fx-font-weight: bold;"/>
                            </HBox>
                        </GridPane>
                        <CheckBox fx:id="notificationsCheckBox" text="Enable desktop notifications" style="-fx-font-size: 13;"/>
                        <Button text="💾 Save Appearance" onAction="#saveSettings"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ ABOUT / DEVELOPERS ══════════════════ -->
        <Tab text="ℹ  About">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;" alignment="TOP_CENTER">

                    <!-- App Info -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 24;" spacing="10" alignment="CENTER">
                        <Label text="🏥 CJC Clinic Patient Management System" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Label text="Version 1.0.0  •  © 2025 CJC School Clinic" style="-fx-text-fill: #777; -fx-font-size: 12;"/>
                        <Separator/>
                        <Label text="A comprehensive patient management solution for the CJC School Clinic,"
                               wrapText="true" style="-fx-text-fill: #555; -fx-font-size: 13;" maxWidth="560"/>
                        <Label text="designed to streamline patient registration, visit tracking, and health record management."
                               wrapText="true" style="-fx-text-fill: #555; -fx-font-size: 13;" maxWidth="560"/>
                    </VBox>

                    <!-- Developers -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 24;" spacing="14">
                        <Label text="👨‍💻  Meet the Developers" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>

                        <!-- Developer 1 -->
                        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-background-color: #FFF8F8; -fx-border-color: #F0C0C0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 14;">
                            <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                                <image>
                                    <Image url="@../Images/shayne.jpg"/>
                                </image>
                            </ImageView>
                            <VBox spacing="4">
                                <Label text="Shayne Noelle Bangcailan" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                                <Label text="Developer" style="-fx-text-fill: #777; -fx-font-size: 12;"/>
                            </VBox>
                        </HBox>

                        <!-- Developer 2 -->
                        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-background-color: #F8FFF8; -fx-border-color: #C0E0C0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 14;">
                            <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                                <image>
                                    <Image url="@../Images/Joshie.jpg"/>
                                </image>
                            </ImageView>
                            <VBox spacing="4">
                                <Label text="Prince Joshua Ngojo" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                                <Label text="Developer" style="-fx-text-fill: #777; -fx-font-size: 12;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Tech Stack -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;" spacing="10">
                        <Label text="🛠  Built With" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Label text="☕ Java 21" style="-fx-background-color: #FFF3E0; -fx-border-color: #FFCC80; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 14; -fx-font-weight: bold;"/>
                            <Label text="🎨 JavaFX 21" style="-fx-background-color: #E3F2FD; -fx-border-color: #90CAF9; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 14; -fx-font-weight: bold;"/>
                            <Label text="🗄 SQLite" style="-fx-background-color: #E8F5E9; -fx-border-color: #A5D6A7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 14; -fx-font-weight: bold;"/>
                            <Label text="📦 Maven" style="-fx-background-color: #FCE4EC; -fx-border-color: #F48FB1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 14; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>

