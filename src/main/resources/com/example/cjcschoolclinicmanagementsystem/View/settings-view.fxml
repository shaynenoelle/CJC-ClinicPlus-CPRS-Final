<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.SettingsController"
      spacing="0" style="-fx-background-color: #F5F5F5;">

    <!-- Header -->
    <HBox style="-fx-background-color: #8B0000; -fx-padding: 16 25;">
        <Label text="⚙  SETTINGS" textFill="WHITE">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
    </HBox>

    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-tab-min-width: 130; -fx-tab-max-width: 180;">

        <!-- ══════════════════ ACADEMIC SETUP ══════════════════ -->
        <Tab text="🏫  Academic Setup">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- School Year -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="School Year"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="The active school year shown on records and reports."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="School Year:" style="-fx-font-weight: bold; -fx-min-width: 110;"/>
                            <TextField fx:id="txtSchoolYear" promptText="e.g. 2025-2026"
                                       prefWidth="200"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="💾 Save" onAction="#saveSchoolYear"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                        </HBox>
                        <Label fx:id="lblSchoolYearStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Departments -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Departments / Colleges"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Abbreviations shown in the College/Dept dropdown when enrolling a patient (e.g. CCIS, COE, CHS)."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtNewDept" promptText="e.g. CCIS"
                                       prefWidth="200"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="+ Add" onAction="#addDepartment"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Remove Selected" onAction="#removeDepartment"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <ListView fx:id="lstDepartments" prefHeight="130"
                                  style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;"/>
                        <Label fx:id="lblDeptStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Courses -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Courses / Programs"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Course names shown in the Course dropdown when enrolling a patient (e.g. BSCS, BSN, Grade 10)."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtNewCourse" promptText="e.g. BSCS"
                                       prefWidth="200"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="+ Add" onAction="#addCourse"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Remove Selected" onAction="#removeCourse"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <ListView fx:id="lstCourses" prefHeight="150"
                                  style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;"/>
                        <Label fx:id="lblCourseStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ CLINICAL PRESETS ══════════════════ -->
        <Tab text="🏥  Clinical Presets">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- Diagnosis Presets -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Diagnosis Presets"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Common diagnoses nurses can select from when attending a patient. Keeps records consistent and charts accurate."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtNewDiagnosis" promptText="e.g. Headache, Fever, Asthma"
                                       prefWidth="280"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="+ Add" onAction="#addDiagnosisPreset"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Remove Selected" onAction="#removeDiagnosisPreset"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <ListView fx:id="lstDiagnosisPresets" prefHeight="150"
                                  style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;"/>
                        <Label fx:id="lblDiagnosisStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Chief Complaint Presets -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Chief Complaint Presets"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Common complaints nurses can select from when a patient checks in (e.g. Stomach ache, Dizziness, Toothache)."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtNewComplaint" promptText="e.g. Stomach ache, Dizziness"
                                       prefWidth="280"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="+ Add" onAction="#addComplaintPreset"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Remove Selected" onAction="#removeComplaintPreset"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <ListView fx:id="lstComplaintPresets" prefHeight="150"
                                  style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;"/>
                        <Label fx:id="lblComplaintStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Medicine List -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Medicine Reference List"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Medicines the clinic stocks. Used as a reference when recording treatment given. Will connect to the inventory system later."
                               style="-fx-text-fill: #555;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtNewMedicine" promptText="e.g. Biogesic, Amoxicillin"
                                       prefWidth="280"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="+ Add" onAction="#addMedicine"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🗑 Remove Selected" onAction="#removeMedicine"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <ListView fx:id="lstMedicines" prefHeight="150"
                                  style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;"/>
                        <Label fx:id="lblMedicineStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ USER ACCOUNTS ══════════════════ -->
        <Tab text="👤  User Accounts">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- System Users -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="System Users"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Accounts that can log in to CJC-Clinic+(CPRS)."
                               style="-fx-text-fill: #555;"/>
                        <HBox spacing="10">
                            <Button text="➕ Add User" onAction="#handleAddUser"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>
                            <Button text="🔑 Reset Password" onAction="#handleResetSelectedPassword"
                                    style="-fx-background-color: #E65100; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                            <Button text="🗑 Delete User" onAction="#handleDeleteUser"
                                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        </HBox>
                        <TableView fx:id="userTable" prefHeight="180"
                                   style="-fx-border-color: #e0e0e0;">
                            <columns>
                                <TableColumn fx:id="colUsername" text="Username" prefWidth="300"/>
                            </columns>
                            <placeholder>
                                <Label text="No users found." style="-fx-text-fill: #aaa;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Change Own Password -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Change My Password"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="280"/>
                            </columnConstraints>
                            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtCurrentUsername" promptText="Your username"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtOldPassword" promptText="Current password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtNewPassword" promptText="New password (min 6 chars)"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter new password"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                        </GridPane>
                        <Label fx:id="lblPasswordStrength" text=""
                               style="-fx-font-style: italic;"/>
                        <Button text="🔒 Change Password" onAction="#handleChangePassword"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ DATA IMPORT ══════════════════ -->
        <Tab text="📥  Data Import">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Import Enrollee List"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Import the registrar's enrollment list to automatically add new patients. Existing IDs will be skipped."
                               style="-fx-text-fill: #555;" wrapText="true"/>

                        <!-- Format guide -->
                        <VBox style="-fx-background-color: #FFF8E1; -fx-border-color: #FFE082;
                                     -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12;"
                              spacing="5">
                            <Label text="📋  Required Column Order (Row 1 = Headers, data starts Row 2):"
                                   style="-fx-font-weight: bold; -fx-text-fill: #5D4037; -fx-font-size: 12;"/>
                            <Label text="  A: Student/Employee ID    B: Last Name    C: First Name    D: Middle Initial"
                                   style="-fx-font-size: 11; -fx-text-fill: #555; -fx-font-family: monospace;"/>
                            <Label text="  E: Gender (M/F)    F: Birthdate (YYYY-MM-DD)    G: Course    H: Year Level"
                                   style="-fx-font-size: 11; -fx-text-fill: #555; -fx-font-family: monospace;"/>
                            <Label text="  I: College/Dept    J: Contact Number    K: Type (Student/Employee)"
                                   style="-fx-font-size: 11; -fx-text-fill: #555; -fx-font-family: monospace;"/>
                        </VBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="txtImportFilePath" promptText="Select .xlsx or .csv file..."
                                       prefWidth="380" editable="false"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="📂 Browse" onAction="#browseImportFile"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </HBox>
                        <Button text="📥 Import Now" onAction="#handleImportEnrollees"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand;
                                       -fx-padding: 10 28; -fx-font-size: 13;"/>
                        <Label fx:id="lblImportStatus" text=""
                               style="-fx-font-size: 11; -fx-font-style: italic;" wrapText="true"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ DATA BACKUP ══════════════════ -->
        <Tab text="💾  Backup">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="18" style="-fx-padding: 25;">

                    <!-- Manual Backup + Export -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Manual Backup &amp; Export"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <Label text="Create a full database backup or export records as CSV."
                               style="-fx-text-fill: #555;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="txtBackupPath" promptText="Backup / export destination folder..."
                                       prefWidth="360"
                                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 8;"/>
                            <Button text="📂 Browse" onAction="#browseBackupFolder"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </HBox>
                        <HBox spacing="12">
                            <Button text="💾 Backup Now" onAction="#handleBackupNow"
                                    style="-fx-background-color: #8B0000; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand;
                                           -fx-padding: 10 28; -fx-font-size: 13;"/>
                            <Button text="📤 Export Health Records (CSV)" onAction="#handleExportPatients"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand;
                                           -fx-padding: 10 20; -fx-font-size: 12;"/>
                            <Button text="📋 Export Visit Log (CSV)" onAction="#handleExportVisits"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand;
                                           -fx-padding: 10 20; -fx-font-size: 12;"/>
                        </HBox>
                        <Label fx:id="lblLastExport" text="Last export: Never"
                               style="-fx-text-fill: #555; -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Auto Backup -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #DDDDDD;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 18;"
                          spacing="12">
                        <Label text="Automatic Backup"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Separator/>
                        <CheckBox fx:id="chkAutoBackup" text="Enable automatic backup"
                                  style="-fx-font-size: 13;"/>
                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160"/>
                                <ColumnConstraints minWidth="220"/>
                            </columnConstraints>
                            <Label text="Frequency:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="comboBackupFrequency" prefWidth="180"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Backup Time:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Spinner fx:id="spinnerHour" prefWidth="65" editable="true"/>
                                <Label text=":" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                                <Spinner fx:id="spinnerMinute" prefWidth="65" editable="true"/>
                                <ComboBox fx:id="comboAMPM" prefWidth="75"/>
                            </HBox>
                            <Label text="Auto Backup Folder:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold;"/>
                            <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <TextField fx:id="txtAutoBackupPath" promptText="Folder for auto backups..."
                                           prefWidth="260"
                                           style="-fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-padding: 6;"/>
                                <Button text="📂" onAction="#browseAutoBackupFolder"
                                        style="-fx-background-color: #607D8B; -fx-text-fill: white;
                                               -fx-cursor: hand; -fx-padding: 6 12;"/>
                            </HBox>
                        </GridPane>
                        <Label fx:id="lblNextBackup" text="Next backup: —"
                               style="-fx-text-fill: #555; -fx-font-style: italic;"/>
                        <Label fx:id="lblLastBackup" text="Last backup: Never"
                               style="-fx-text-fill: #555; -fx-font-style: italic;"/>
                        <Button text="💾 Save Backup Settings" onAction="#saveBackupSettings"
                                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 24;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════ ABOUT ══════════════════ -->
        <Tab text="ℹ  About">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #F5F5F5;">
                <VBox spacing="16" style="-fx-padding: 24 40 24 40; -fx-background-color: #F5F5F5;"
                      alignment="TOP_CENTER">

                    <VBox alignment="CENTER" spacing="6"
                          style="-fx-background-color: white; -fx-border-color: #E0E0E0;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 24 20; -fx-border-width: 1;" maxWidth="660">
                        <Label text="CJC-Clinic+ (CPRS)"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>
                        <Label text="Clinic Patient Records System"
                               style="-fx-font-size: 13; -fx-text-fill: #555;"/>
                        <Label text="Version 1.0.0  •  © 2025–2026 CJC School Clinic"
                               style="-fx-font-size: 11; -fx-text-fill: #999;"/>
                        <Label text="Built to simplify patient registration, clinic visit tracking, and health record management for Cor Jesu College."
                               wrapText="true" textAlignment="CENTER"
                               style="-fx-font-size: 12; -fx-text-fill: #666; -fx-padding: 8 0 0 0;"
                               maxWidth="560"/>
                    </VBox>

                    <VBox spacing="14"
                          style="-fx-background-color: white; -fx-border-color: #E0E0E0;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 22 20; -fx-border-width: 1;" maxWidth="660">
