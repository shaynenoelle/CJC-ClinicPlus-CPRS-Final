<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.PatientRegistryController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>

    <Label text="PATIENT REGISTRY" textFill="#8B0000">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button onAction="#openAddPatientForm"
                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                text="[ + Add New Patient ]" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField promptText="Search Name/ID..." prefWidth="250.0"
                   style="-fx-border-color: #8B0000; -fx-border-width: 0 0 2 0; -fx-background-color: transparent;" />
    </HBox>

    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colID" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="250.0" text="Name" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colDept" prefWidth="120.0" text="Dept" />
            <TableColumn prefWidth="150.0" text="Action" />
        </columns>
    </TableView>
</VBox>