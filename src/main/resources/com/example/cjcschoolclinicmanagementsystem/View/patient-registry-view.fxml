<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" style="-fx-background-color: #f5f5f5;"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cjcschoolclinicmanagementsystem.controller.PatientRegistryController">
    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="10.0" /></padding>

    <!-- HEADER ROW -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2">
            <Label text="Patient List Record" textFill="#8B0000">
                <font><Font name="System Bold" size="20.0" /></font>
            </Label>
            <Label text="Registered Patients and Health Records"
                   style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnShowArchived" onAction="#toggleArchived"
                style="-fx-background-color: #888; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-background-radius: 5;"
                text="📦 Show Archived" />
        <Button onAction="#openAddPatientForm"
                style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 7 16 7 16;"
                text="+ Add Patient" />
    </HBox>

    <!-- SEARCH + FILTER BAR — wraps on small screens -->
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">
        <TextField fx:id="txtSearch" promptText="🔍  Search by ID or Name..."
                   prefWidth="220.0" onKeyReleased="#handleSearch"
                   style="-fx-border-color: #ccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;" />
        <Separator orientation="VERTICAL" />
        <Label text="College/Dept:" style="-fx-text-fill: #555; -fx-font-size: 12;" />
        <ComboBox fx:id="cmbCollege" prefWidth="110" onAction="#handleSearch" style="-fx-font-size: 12;" />
        <Label text="Type:" style="-fx-text-fill: #555; -fx-font-size: 12;" />
        <ComboBox fx:id="cmbType" prefWidth="100" onAction="#handleSearch" style="-fx-font-size: 12;" />
        <Label text="Year:" style="-fx-text-fill: #555; -fx-font-size: 12;" />
        <ComboBox fx:id="cmbYear" prefWidth="120" onAction="#handleSearch" style="-fx-font-size: 12;" />
        <Separator orientation="VERTICAL" />
        <Label text="Sort:" style="-fx-text-fill: #555; -fx-font-size: 12;" />
        <ComboBox fx:id="cmbSort" prefWidth="140" onAction="#handleSearch" style="-fx-font-size: 12;" />
        <Button onAction="#clearFilters"
                style="-fx-background-color: #eee; -fx-text-fill: #555; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 4;"
                text="✕ Clear" />
    </FlowPane>

    <!-- TABLE -->
    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 6;">
        <columns>
            <TableColumn fx:id="colID"          prefWidth="100.0" text="Patient ID#" />
            <TableColumn fx:id="colLastName"    prefWidth="100.0" text="Last Name" />
            <TableColumn fx:id="colFirstName"   prefWidth="90.0" text="First Name" />
            <TableColumn fx:id="colMI"          prefWidth="36.0"  text="M.I." />
            <TableColumn fx:id="colGender"      prefWidth="58.0"  text="Gender" />
            <TableColumn fx:id="colBirthdate"   prefWidth="85.0"  text="Birthdate" />
            <TableColumn fx:id="colYear"        prefWidth="55.0"  text="Year" />
            <TableColumn fx:id="colCourse"      prefWidth="80.0" text="Course" />
            <TableColumn fx:id="colDept"        prefWidth="80.0"  text="College/Dept" />
            <TableColumn fx:id="colType"        prefWidth="68.0"  text="Type" />
            <TableColumn fx:id="colContact"     prefWidth="100.0" text="Contact No." />
            <TableColumn fx:id="colMedHistory"  prefWidth="140.0" text="Medical History" />
            <TableColumn fx:id="colStatus"      prefWidth="65.0"  text="Status" />
            <TableColumn fx:id="colAction"      prefWidth="200.0" text="Action" />
        </columns>
        <placeholder>
            <Label text="No patients found." style="-fx-text-fill: #aaa; -fx-font-size: 13;" />
        </placeholder>
    </TableView>

    <!-- FOOTER -->
    <HBox alignment="CENTER" spacing="0"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-padding: 8 14 8 14;">
        <!-- Left: Total Patients -->
        <Label fx:id="lblTotal" text="Total Patients: 0" style="-fx-font-size: 12; -fx-text-fill: #555;" />
        <!-- Center: Pagination -->
        <HBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
            <Button fx:id="btnPrev" onAction="#prevPage"
                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-font-size: 11; -fx-padding: 5 14 5 14;"
                    text="Prev" />
            <Label fx:id="lblPage" text="Page 1 of 1" style="-fx-font-size: 12; -fx-text-fill: #333;" />
            <Button fx:id="btnNext" onAction="#nextPage"
                    style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-font-size: 11; -fx-padding: 5 14 5 14;"
                    text="Next" />
        </HBox>
        <!-- Right: Refresh -->
        <Button onAction="#refreshTable"
                style="-fx-background-color: #eee; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-size: 12;"
                text="⟳ Refresh" />
    </HBox>
</VBox>
